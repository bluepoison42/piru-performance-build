--- a/Shared/TimelineGraphView.swift
+++ b/Shared/TimelineGraphView.swift
@@ -838,6 +838,47 @@ struct TimelineGraphView: View, Equatable {
 /// time slides sideways when centering it would run past either edge of the
 /// plot (``TimelineGraphRenderer/milestoneLabelCenterX(_:labelWidth:geom:)``,
 /// the same math the canvas uses to break the Now rule around it).
+#if os(Android)
+    /// SkipFuseUI hosts no custom `Layout`: the glyph and time stack in a VStack centered on
+    /// (`x`, `y`), and the time is offset by the same clamp, applied to the width Compose
+    /// measured for it. Until that first measurement the time sits centered under the glyph.
+    private struct MilestoneStackLayout<Glyph: View, Time: View>: View {
+        let x: CGFloat
+        let y: CGFloat
+        let geom: TimelineGraphRenderer.GraphGeometry
+        let glyph: Glyph
+        let time: Time
+        @State private var timeWidth: CGFloat = 0
+
+        init(x: CGFloat, y: CGFloat, geom: TimelineGraphRenderer.GraphGeometry, @MilestoneStackBuilder content: () -> (Glyph, Time)) {
+            self.x = x
+            self.y = y
+            self.geom = geom
+            let parts = content()
+            glyph = parts.0
+            time = parts.1
+        }
+
+        var body: some View {
+            VStack(spacing: TimelineGraphRenderer.MilestoneMetrics.spacing) {
+                glyph
+                time
+                    .onGeometryChange(for: CGFloat.self, of: \.size.width) { timeWidth = $0 }
+                    .offset(x: TimelineGraphRenderer.milestoneLabelCenterX(x, labelWidth: timeWidth, geom: geom) - x)
+            }
+            .fixedSize()
+            .position(x: x, y: y)
+        }
+    }
+
+    /// The stack's two parts, glyph then time, kept apart so the time can move on its own.
+    @resultBuilder
+    private enum MilestoneStackBuilder {
+        static func buildBlock<Glyph: View, Time: View>(_ glyph: Glyph, _ time: Time) -> (Glyph, Time) {
+            (glyph, time)
+        }
+    }
+#else
 private struct MilestoneStackLayout: Layout {
     let x: CGFloat
     let y: CGFloat
@@ -861,3 +902,4 @@ private struct MilestoneStackLayout: Layout {
         )
     }
 }
+#endif
