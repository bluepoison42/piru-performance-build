+                    if sheet == nil {
+                        await AppUpdateCheck.shared.finishLaunchCheck()
+                        if sheet == nil { sheet = nextSheet() }
+                    }
+                #endif
             }
     }
 
@@ -63,6 +79,12 @@ struct LaunchSheetModifier: ViewModifier {
         if let notice = UpdateNotice.next(in: modelContext) {
             return .updateNotice(notice)
         }
+        #if os(Android)
+            if let release = AppUpdateCheck.shared.releaseToAnnounce {
+                AppUpdateCheck.shared.markAnnounced(release)
+                return .appUpdate(release)
+            }
+        #endif
         if discordInviteIsDue {
             discordShown = true
             return .discordInvite
