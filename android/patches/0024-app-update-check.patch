         case let .updateNotice(notice): "updateNotice.\(notice.rawValue)"
         case .discordInvite: "discordInvite"
+        #if os(Android)
+            case let .appUpdate(release): "appUpdate.\(release.tag)"
+        #endif
         }
     }
 }
