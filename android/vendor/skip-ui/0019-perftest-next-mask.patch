Cold-start piru_next_mask experiments: fixed Canvas flag, simple color backgrounds, and actual-tab decorator slots; default zero.

diff --git a/Sources/SkipUI/Skip/PiruNextPerf.kt b/Sources/SkipUI/Skip/PiruNextPerf.kt
new file mode 100644
--- /dev/null
+++ b/Sources/SkipUI/Skip/PiruNextPerf.kt
@@ -0,0 +1,20 @@
+package skip.ui
+
+object PiruNextPerf {
+    @Volatile private var mask: Int = 0
+    private var initialized = false
+
+    @JvmStatic
+    @Synchronized
+    fun initialize(value: Int) {
+        if (initialized) return
+        mask = value
+        initialized = true
+    }
+
+    @JvmStatic
+    fun enabled(bit: Int): Boolean = (mask and bit) != 0
+
+    @JvmStatic
+    fun fixedCanvasEnabled(): Boolean = enabled(1)
+}
