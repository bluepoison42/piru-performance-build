Retain a tab view in a restartable scope and reuse the current top-level tab evaluation; piru_next_mask bit 16 bypasses retention.

diff --git a/Sources/SkipUI/Skip/RetainedContent.kt b/Sources/SkipUI/Skip/RetainedContent.kt
new file mode 100644
index 0000000..56a7432
--- /dev/null
+++ b/Sources/SkipUI/Skip/RetainedContent.kt
@@ -0,0 +1,38 @@
+// Copyright 2023–2026 Skip
+// SPDX-License-Identifier: MPL-2.0
+package skip.ui
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.remember
+
+class RetainedViewStorage {
+    private var recomposeOverride: Any? = null
+    private var view: View? = null
+
+    fun view(recomposeOverride: Any, content: () -> View): View {
+        val retained = view
+        if (retained != null && this.recomposeOverride == recomposeOverride) {
+            return retained
+        }
+        val created = content()
+        this.recomposeOverride = recomposeOverride
+        view = created
+        return created
+    }
+}
+
+// Keep body evaluation in a restartable scope so its state reads can invalidate it.
+// piru_next_mask bit 16 bypasses retention for comparison.
+@Composable
+fun RenderRetainedContent(recomposeOverride: Any, content: () -> View, context: ComposeContext) {
+    val storage = remember { RetainedViewStorage() }
+    val view = if (PiruNextPerf.enabled(16)) content() else storage.view(recomposeOverride, content)
+    RenderRetainedView(view, context)
+}
+
+@Composable
+private fun RenderRetainedView(view: View, context: ComposeContext) {
+    for (renderable in view.Evaluate(context, 0)) {
+        renderable.Render(context)
+    }
+}
