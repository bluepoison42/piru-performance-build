+// Copyright 2023–2026 Skip
+// SPDX-License-Identifier: MPL-2.0
+package skip.ui
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.runtime.mutableStateListOf
+import androidx.compose.runtime.remember
+import kotlinx.coroutines.delay
+
+/// Holds the view an equality gate built, until the gate's override changes.
+class RetainedViewStorage {
+    private var recomposeOverride: Any? = null
+    private var view: View? = null
+
+    fun view(recomposeOverride: Any, content: () -> View): View {
+        val retained = view
+        if (retained != null && this.recomposeOverride == recomposeOverride) {
+            return retained
+        }
+        val created = content()
+        this.recomposeOverride = recomposeOverride
+        view = created
+        return created
+    }
+}
+
+/// Renders the content of an equality gate. While `recomposeOverride` stays equal the view built
+/// the first time is rendered again, and Compose skips it: a re-render of the gate's parent no
+/// longer rebuilds the subtree. The view is evaluated in `RenderRetainedView`'s own scope, so
+/// state its body reads re-evaluates it as usual.
+/// `piru_next_mask` bit 16 turns the gate off, to measure it.
+@Composable
+fun RenderRetainedContent(recomposeOverride: Any, content: () -> View, context: ComposeContext) {
+    val storage = remember { RetainedViewStorage() }
+    val view = if (PiruNextPerf.enabled(16)) content() else storage.view(recomposeOverride, content)
+    RenderRetainedView(view, context)
+}
+
+@Composable
+private fun RenderRetainedView(view: View, context: ComposeContext) {
+    for (renderable in view.Evaluate(context, 0)) {
+        renderable.Render(context)
+    }
+}
+
+/// The tabs a tab bar builds ahead of their first visit: one more every 700 ms, starting 1.5 s
+/// after the bar appears, so the launch tab settles first and each build is its own frame.
+/// `piru_next_mask` bit 8 turns this off, to measure it.
+@Composable
+fun rememberPreparedTabs(count: Int): List<Int> {
+    val prepared = remember { mutableStateListOf<Int>() }
+    LaunchedEffect(count) {
+        if (PiruNextPerf.enabled(8)) {
+            return@LaunchedEffect
+        }
+        delay(1500)
+        for (index in 0 until count) {
+            if (!prepared.contains(index)) {
+                prepared.add(index)
+                delay(700)
+            }
+        }
+    }
+    return prepared
+}
