Clearing a focus binding releases Compose focus in a SideEffect; recheck ownership inside the effect, so a transfer to a field composed earlier keeps its new target.

diff --git a/Sources/SkipUI/SkipUI/System/Focus.swift b/Sources/SkipUI/SkipUI/System/Focus.swift
index a195133..3b7cf2c 100644
--- a/Sources/SkipUI/SkipUI/System/Focus.swift
+++ b/Sources/SkipUI/SkipUI/System/Focus.swift
@@ -56,7 +56,13 @@ extension View {
                     }
                 }
             } else if isFocused.value {
-                SideEffect { focusManager.clearFocus() }
+                SideEffect {
+                    // Recheck ownership after other focus effects have run: in a transfer from
+                    // this field to another composed before it, the other's request has landed.
+                    if value != binding.wrappedValue && isFocused.value {
+                        focusManager.clearFocus()
+                    }
+                }
             }
             renderable.Render(context: context)
         })
