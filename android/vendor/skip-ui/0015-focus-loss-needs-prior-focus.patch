+                isRevealed = true
+                isFocused = true
+            }
+            .accessibilityIdentifier("reveal")
+            if isRevealed {
+                TextField("Name", text: $text)
+                    .focused($isFocused)
+                    .accessibilityIdentifier("field")
+            }
+        }
