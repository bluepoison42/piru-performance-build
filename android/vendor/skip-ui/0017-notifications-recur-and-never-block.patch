+
+    public override func onReceive(context: Context, intent: Intent) {
+        guard intent.action == Intent.ACTION_TIMEZONE_CHANGED || intent.action == Intent.ACTION_TIME_CHANGED else {
+            return
+        }
+        // The broadcast names the new zone, which the process's default zone may not have adopted yet.
+        var timeZone = TimeZone.current
+        if let identifier = intent.getStringExtra(Intent.EXTRA_TIMEZONE), let named = TimeZone(identifier: identifier) {
+            timeZone = named
+        }
+        let applicationContext = context.getApplicationContext()
+        let result = goAsync()
+        Task {
+            await UNUserNotificationCenter.rearmCalendarRequests(in: timeZone, context: applicationContext)
+            result.finish()
+        }
+    }
