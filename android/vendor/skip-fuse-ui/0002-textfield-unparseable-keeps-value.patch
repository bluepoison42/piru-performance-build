TextField(value:format:) parses with try!, which kills the app on the first keystroke that empties a numeric field or leaves "7."; text that doesn't parse keeps the last value, as SwiftUI does (the fix proposed upstream).

diff --git a/Sources/SkipSwiftUI/Text/TextField.swift b/Sources/SkipSwiftUI/Text/TextField.swift
index 154e740..1b77807 100644
--- a/Sources/SkipSwiftUI/Text/TextField.swift
+++ b/Sources/SkipSwiftUI/Text/TextField.swift
@@ -41,8 +41,14 @@ extension TextField {
 
     private static func text<F>(from value: Binding<F.FormatInput>, format: F) -> Binding<String> where F : ParseableFormatStyle, F.FormatOutput == String {
         let getText: (F.FormatInput) -> String = { format.format($0) }
-        let setText: (String) -> F.FormatInput = { try! format.parseStrategy.parse($0) }
-        return Binding<String>(get: { getText(value.wrappedValue) }, set: { value.wrappedValue = setText($0) })
+        // As in SwiftUI, text that does not parse (an emptied field, a lone ".") keeps the last
+        // value; a `try!` here kills the app on the first keystroke that clears the field. Only a
+        // different value is written back, so typing "7." after "7" re-renders nothing.
+        return Binding<String>(get: { getText(value.wrappedValue) }, set: { text in
+            if let input = try? format.parseStrategy.parse(text), getText(input) != getText(value.wrappedValue) {
+                value.wrappedValue = input
+            }
+        })
     }
 
     // Error: Cannot find AutoreleasingUnsafeMutablePointer in scope
